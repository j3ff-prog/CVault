# ─────────────────────────────────────────────────────────
# CVault Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to GitHub — it's in .gitignore.
# ─────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars
JWT_SECRET_KEY=another-long-random-string-different-from-secret-key

# Google Gemini
# Get your free API key at: https://aistudio.google.com/app/apikey
# No credit card needed. Works from Kenya.
GEMINI_API_KEY=AIza...

# Paystack
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# Gmail SMTP
# Step 1: myaccount.google.com → Security → turn on 2-Step Verification
# Step 2: Search "App passwords" → create one named "CVault"
# Step 3: Paste the 16-char password below (no spaces)
GMAIL_USER=Jeff.006760@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Owner email — this email gets unlimited credits forever when logged in
OWNER_EMAIL=Jeff.006760@gmail.com

# Frontend URL (your Render static site URL or Netlify URL)
FRONTEND_URL=https://your-cvault.onrender.com

# Database file path
DATABASE_PATH=cvault.db
